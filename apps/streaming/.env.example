PORT=7000

# Must be the same value as JWT_SECRET in apps/http-server/.env. http-server
# signs both the host's login token and the participant token handed out on
# join; this service checks them before it issues a video room token.
JWT_SECRET=<yourJWTSecret>

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/Qtrive

# Where this service reaches the LiveKit API (server to server).
LIVEKIT_URL=http://localhost:7880
# Where browsers connect for media. wss:// in production.
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# The dev pair below matches livekit/livekit.dev.yaml. Production refuses to start
# without real keys; they must match the keys in the LiveKit server config.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=rexial-local-dev-secret-not-for-production

# Comma-separated origins allowed to call this service.
CORS_ORIGIN=http://localhost:5173
